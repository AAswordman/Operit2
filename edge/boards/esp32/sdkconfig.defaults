CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_FREERTOS_HZ=1000
# Main also performs synchronous UI authorization and storage decoding.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# Runtime disables console logs once binary Link owns UART. Keep C errors,
# and return driver errors without linking their repeated ESP_RETURN_ON_* log text.
CONFIG_LOG_DEFAULT_LEVEL_ERROR=y
CONFIG_COMPILER_OPTIMIZATION_CHECKS_SILENT=y
# Keep native assertion checks and abort backtraces; resolve their addresses
# using the matching ELF instead of embedding condition/file strings.
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_STA_ENABLED=y
# Keep Wi-Fi RX buffers proportional to this low-memory Edge device.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
# Browser setup requests include User-Agent, client hints and other headers.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=4096
CONFIG_SPIFFS=y

# Native device requests verify HTTPS using the ESP-IDF certificate bundle.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
# Native HTTP serves plain local setup; only outbound requests need TLS.
# Keep HTTPS client verification/ciphers and omit the unused TLS server role.
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y

# Keep microphone DMA interrupts running during Flash/NVS cache stalls.
CONFIG_I2S_ISR_IRAM_SAFE=y

# This board configures open or WPA/WPA2-Personal stations (wifi.rs), with
# SSID/password credentials only. Enterprise EAP and WPA3-only association
# paths cannot be selected by its configuration UI or station setup.
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n
CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA=n

# Use the ESP32 ROM printf/scanf implementation for bounded native UI fields.
CONFIG_NEWLIB_NANO_FORMAT=y

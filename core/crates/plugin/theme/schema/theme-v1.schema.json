    "bubbleImage": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "asset": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^assets/images/([a-z0-9_-]+/)?[a-z0-9_-]+\\.(png|jpg|jpeg|svg)$"
        },
        "renderMode": {
          "type": "string",
          "enum": [
            "tiled_nine_slice",
            "nine_patch"
          ],
          "default": "tiled_nine_slice"
        },
        "crop": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "left": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.45,
              "default": 0
            },
            "top": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.45,
              "default": 0
            },
            "right": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.45,
              "default": 0
            },
            "bottom": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.45,
              "default": 0
            }
          },
          "required": [
            "left",
            "top",
            "right",
            "bottom"
          ],
          "default": {}
        },
        "slice": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "xStart": {
              "type": "number",
              "minimum": 0.05,
              "maximum": 0.9,
              "default": 0.35
            },
            "xEnd": {
              "type": "number",
              "minimum": 0.06,
              "maximum": 0.95,
              "default": 0.65
            },
            "yStart": {
              "type": "number",
              "minimum": 0.05,
              "maximum": 0.9,
              "default": 0.35
            },
            "yEnd": {
              "type": "number",
              "minimum": 0.06,
              "maximum": 0.95,
              "default": 0.65
            }
          },
          "required": [
            "xStart",
            "xEnd",
            "yStart",
            "yEnd"
          ],
          "default": {}
        },
        "scale": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 3,
          "default": 1
        }
      },
      "required": [
        "asset",
        "renderMode",
        "crop",
        "slice",
        "scale"
      ],
      "default": null
    },
    "bubble": {
      "type": "object",
      "additionalProperties": false,
      "properties": {

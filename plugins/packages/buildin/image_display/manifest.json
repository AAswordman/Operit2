{
  "schema_version": 1,
  "toolpkg_id": "com.operit.image_display",
  "version": "1.0.0",
  "api_version": "2.0.0",
  "main": "dist/main.js",
  "display_name": { "zh": "图片展示", "en": "Image Display" },
  "description": {
    "zh": "让 AI 把图片直接显示在回复里；图片存进设备空间，其他设备同步后也能看到。",
    "en": "Lets the AI show images in its replies; they are saved to your Space and sync across devices."
  },
  "logo": "package_logo",
  "installation_scope": "space",
  "enabled_by_default": true,
  "subpackages": [],
  "resources": [
    {
      "key": "package_logo",
      "path": "resources/logo.svg",
      "mime": "image/svg+xml"
    }
  ]
}

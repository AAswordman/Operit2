{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "rootDir": "src",
    "outDir": "dist",
    "lib": ["es2020"],
    "strict": false,
    "strictNullChecks": true,
    "noImplicitReturns": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "../../../types/**/*.d.ts"],
  "exclude": ["dist"]
}

{
  "schema_version": 1,
  "toolpkg_id": "com.operit.edge_watch_pet",
  "version": "0.2.0",
  "api_version": "2.0.0",
  "main": "dist/main.js",
  "display_name": {
    "zh": "手表桌宠",
    "en": "Watch Pet"
  },
  "description": {
    "zh": "任务状态猫手表伴侣：同步工作、思考、审批、完成与待机，管理配色、触感和亮屏。",
    "en": "Task Status Cat watch companion with live task moods, interaction and device settings."
  },
  "enabled_by_default": false,
  "resources": [
    {
      "key": "watch_studio",
      "path": "resources/studio.html",
      "mime": "text/html"
    },
    {
      "key": "working",
      "path": "resources/working.webp",
      "mime": "image/webp"
    },
    {
      "key": "thinking",
      "path": "resources/thinking.webp",
      "mime": "image/webp"
    },
    {
      "key": "approval",
      "path": "resources/approval.webp",
      "mime": "image/webp"
    },
    {
      "key": "completed",
      "path": "resources/completed.webp",
      "mime": "image/webp"
    },
    {
      "key": "idle",
      "path": "resources/idle.webp",
      "mime": "image/webp"
    },
    {
      "key": "error",
      "path": "resources/error.webp",
      "mime": "image/webp"
    }
  ]
}

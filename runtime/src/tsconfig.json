{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "rootDir": ".",
    "outDir": "web",
    "removeComments": true,
    "strict": false,
    "noImplicitAny": true,
    "noEmitOnError": true,
    "skipLibCheck": true
  },
  "include": [
    "operit_runtime_bridge.ts",
    "operit_data_rescue.ts",
    "operit_data_rescue_worker.ts",
    "operit_runtime_worker.ts",
    "operit_javascript_runtime.ts",
    "operit_javascript_transport.ts",
    "operit_javascript_worker.ts",
    "operit_model_install_worker.ts",
    "v86_runtime_worker.ts"
  ]
}

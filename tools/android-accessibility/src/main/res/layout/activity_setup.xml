<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/setup_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/provider_background" android:fillViewport="true" android:clipToPadding="false">
    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:id="@+id/setup_content" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal" android:orientation="vertical" android:padding="24dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:layout_width="52dp" android:layout_height="52dp" android:src="@drawable/ic_provider_logo" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/brand_name"
                        android:fontFamily="sans-serif-medium" android:textSize="20sp" android:textColor="@color/provider_text" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/provider_label"
                        android:textSize="12sp" android:textColor="@color/provider_secondary" />
                </LinearLayout>
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="36dp"
                android:text="@string/hero_title" android:textSize="30sp" android:fontFamily="sans-serif-medium" android:textColor="@color/provider_text"
                android:lineSpacingExtra="3dp" android:accessibilityHeading="true" />
            <TextView style="@style/ProviderBody" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="@string/hero_description" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp"
                android:background="@drawable/provider_card" android:padding="22dp" android:orientation="vertical">
                <TextView android:id="@+id/status_badge" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp" android:paddingVertical="7dp" android:textSize="12sp" android:fontFamily="sans-serif-medium" />
                <TextView android:id="@+id/service_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:textSize="23sp" android:fontFamily="sans-serif-medium" android:textColor="@color/provider_text"
                    android:accessibilityLiveRegion="polite" />
                <TextView android:id="@+id/status_description" style="@style/ProviderBody" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp" />
                <Button android:id="@+id/open_settings" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="22dp"
                    android:background="@drawable/provider_button" android:backgroundTint="@null" android:stateListAnimator="@null"
                    android:textColor="#FFFFFF" android:textSize="15sp" android:textAllCaps="false" android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="12dp" />
            </LinearLayout>

            <TextView style="@style/ProviderSectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="30dp" android:text="@string/steps_title" android:accessibilityHeading="true" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="horizontal">
                <TextView style="@style/ProviderStepNumber" android:text="01" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                    <TextView style="@style/ProviderSectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/step_one_title" android:textSize="14sp" />
                    <TextView style="@style/ProviderBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="@string/step_one_description" android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="horizontal">
                <TextView style="@style/ProviderStepNumber" android:text="02" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                    <TextView style="@style/ProviderSectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/step_two_title" android:textSize="14sp" />
                    <TextView style="@style/ProviderBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="@string/step_two_description" android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp"
                android:background="@drawable/provider_card" android:padding="20dp" android:orientation="vertical">
                <TextView style="@style/ProviderSectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/control_title" android:textSize="14sp" />
                <TextView style="@style/ProviderBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/control_description" android:textSize="13sp" />
            </LinearLayout>
            <TextView android:id="@+id/provider_version" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:layout_marginBottom="8dp" android:gravity="center" android:textSize="12sp" android:textColor="@color/provider_secondary" />
        </LinearLayout>
    </FrameLayout>
</ScrollView>

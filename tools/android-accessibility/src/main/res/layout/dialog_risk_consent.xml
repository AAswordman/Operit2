<?xml version="1.0" encoding="utf-8"?>
<!-- Risk acknowledgment dialog body. Hosted in a plain Dialog whose window background carries the
     24dp provider card radius, so this root only owns padding; the action row is appended at
     runtime to keep the buttons inside the rounded panel. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/consent_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="24dp"
    android:paddingBottom="20dp">

    <TextView
        android:id="@+id/consent_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/provider_text"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/consent_body"
        style="@style/ProviderBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/provider_soft_tile"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/consent_statement_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/provider_primary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/consent_statement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/provider_text"
            android:textSize="15sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/consent_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/provider_input"
        android:gravity="top|start"
        android:hint="@string/consent_input_hint"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textCapSentences"
        android:maxLines="5"
        android:minLines="2"
        android:padding="14dp"
        android:textColor="@color/provider_text"
        android:textColorHint="@color/provider_secondary"
        android:textSize="14sp" />
</LinearLayout>
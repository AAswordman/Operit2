<resources>
    <style name="ProviderTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/provider_primary</item>
        <item name="android:windowBackground">@color/provider_background</item>
        <item name="android:colorBackground">@color/provider_background</item>
        <item name="android:textColorPrimary">@color/provider_text</item>
        <item name="android:textColorSecondary">@color/provider_secondary</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="ProviderBody">
        <item name="android:textColor">@color/provider_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">5dp</item>
    </style>
    <style name="ProviderSectionTitle">
        <item name="android:textColor">@color/provider_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="ProviderStepNumber">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/provider_soft_tile</item>
        <item name="android:textColor">@color/provider_primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>

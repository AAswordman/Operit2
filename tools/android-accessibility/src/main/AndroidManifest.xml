<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission android:name="app.operit.accessibility.permission.AUTOMATE_UI" android:protectionLevel="signature" />
    <application android:label="@string/app_name" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false">
        <activity android:name=".SetupActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".UiAccessibilityService" android:exported="true" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibility_service" />
        </service>
        <service android:name=".UiAutomationBinderService" android:exported="true" android:permission="app.operit.accessibility.permission.AUTOMATE_UI" />
    </application>
</manifest>

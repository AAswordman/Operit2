diff --git a/fs/fake-rebuild.c b/fs/fake-rebuild.c
--- a/fs/fake-rebuild.c
+++ b/fs/fake-rebuild.c
@@ -33,6 +33,14 @@
     sqlite3 *db = fs->db;
     int err;
 
+    // This runs on a 32 KiB Linux task stack, including all SQLite calls.
+    // 2000 list heads alone take 32,000 bytes on a 64-bit host. Keep them
+    // off the stack so rebuilding an imported rootfs cannot corrupt tasks.
+    enum { HASH_SIZE = 2000 };
+    struct list *hashtable = malloc(HASH_SIZE * sizeof(*hashtable));
+    if (hashtable == NULL)
+        return _ENOMEM;
+
     EXEC("begin");
     EXEC("create table paths_old (path blob primary key, inode integer)");
     EXEC("create table stats_old (inode integer primary key, stat blob)");
@@ -45,8 +53,6 @@
     sqlite3_stmt *write_path = PREPARE("insert into paths (path, inode) values (?, ?)");
     sqlite3_stmt *write_stat = PREPARE("replace into stats (inode, stat) values (?, ?)");
 
-    struct list hashtable[2000];
-#define HASH_SIZE (sizeof(hashtable)/sizeof(hashtable[0]))
     for (unsigned i = 0; i < HASH_SIZE; i++)
         list_init(&hashtable[i]);
 
@@ -111,6 +117,8 @@
         }
     }
 
+    free(hashtable);
+
     EXEC("drop table paths_old");
     EXEC("drop table stats_old");
     EXEC("commit");

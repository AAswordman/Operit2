+// Validate legacy roots too: a new marker file is not required for adoption.
+bool fakefs_prepare(const char *fs, struct fakefsify_error *err_out) {
+    char path[PATH_MAX];
+    snprintf(path, sizeof(path), "%s/data", fs);
+    int root_fd = open(path, O_RDONLY | O_DIRECTORY);
+    if (root_fd < 0) {
+        err_out->type = ERR_POSIX;
+        err_out->code = errno;
+        err_out->message = strdup(strerror(errno));
+        return false;
+    }
+    snprintf(path, sizeof(path), "%s/meta.db", fs);
+    sqlite3 *db = NULL;
+    sqlite3_stmt *statement = NULL;
+    bool ok = false;
+    int err = sqlite3_open_v2(path, &db, SQLITE_OPEN_READWRITE, NULL);
+    err_out->type = ERR_SQLITE;
+    if (err != SQLITE_OK)
+        goto out;
+    sqlite3_busy_timeout(db, 1000);
+    err = sqlite3_prepare_v2(db, "pragma user_version", -1, &statement, NULL);
+    if (err != SQLITE_OK || (err = sqlite3_step(statement)) != SQLITE_ROW)
+        goto out;
+    int version = sqlite3_column_int(statement, 0);
+    sqlite3_finalize(statement);
+    statement = NULL;
+    // Only this exact state is known to be an uncommitted legacy import.
+    if (version == 0) {
+        err = sqlite3_prepare_v2(db, "select count(*) from sqlite_master", -1, &statement, NULL);
+        if (err != SQLITE_OK || (err = sqlite3_step(statement)) != SQLITE_ROW)
+            goto out;
+        if (sqlite3_column_int(statement, 0) == 0) {
+            err_out->type = ERR_INCOMPLETE;
+            err_out->message = strdup("Uncommitted iSH root import");
+            goto out;
+        }
+        sqlite3_finalize(statement);
+        statement = NULL;
+    }
+    if (version < 0 || version > 3) {
+        err_out->message = strdup("Unsupported iSH root database version");
+        goto out;
+    }
+    const char *checks[] = {
+        "select id, db_inode from meta",
+        "select path, inode from paths limit 0",
+        "select inode, stat from stats limit 0",
+        "select stat from paths join stats using(inode) where path = x'' and length(stat) = 16",
+    };
+    for (unsigned i = 0; i < sizeof(checks) / sizeof(checks[0]); i++) {
+        err = sqlite3_prepare_v2(db, checks[i], -1, &statement, NULL);
+        if (err != SQLITE_OK)
+            goto out;
+        err = sqlite3_step(statement);
+        if (err != (i == 1 || i == 2 ? SQLITE_DONE : SQLITE_ROW))
+            goto out;
+        if (i == 0 && (sqlite3_column_type(statement, 0) != SQLITE_INTEGER ||
+                       sqlite3_column_int(statement, 0) != 0 ||
+                       sqlite3_column_type(statement, 1) != SQLITE_INTEGER ||
+                       sqlite3_step(statement) != SQLITE_DONE))
+            goto out;
+        sqlite3_finalize(statement);
+        statement = NULL;
+    }
+    ok = true;
+out:
+    if (!ok && err_out->message == NULL)
+        err_out->message = strdup(err == SQLITE_DONE ? "Incomplete iSH root metadata" : sqlite3_errmsg(db));
+    err_out->code = err;
+    sqlite3_finalize(statement);
+    sqlite3_close(db);
+    if (ok) {
+        char *message = NULL;
+        ok = fake_db_prepare(path, root_fd, &message) == 0;
+        if (!ok) {
+            err_out->type = ERR_SQLITE;
+            err_out->message = message;
+        }
+    }
+    close(root_fd);
+    return ok;
+}

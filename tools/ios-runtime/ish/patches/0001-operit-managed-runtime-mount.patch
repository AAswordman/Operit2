+
+// Mounts one App-owned directory without invoking the document picker.
+int iosfs_mount_app_directory(const char *directory, const char *mount_point) {
+    if (directory == NULL || mount_point == NULL || directory[0] != '/' || mount_point[0] != '/')
+        return _EINVAL;
+    NSString *source = [NSString stringWithFormat:@"%@%s", kOperitAppDirectoryPrefix, directory];
+    lock(&mounts_lock);
+    struct mount *mount;
+    list_for_each_entry(&mounts, mount, mounts) {
+        if (strcmp(mount->point, mount_point) == 0) {
+            int result = strcmp(mount->source, directory) == 0 ? 0 : _EBUSY;
+            unlock(&mounts_lock);
+            return result;
+        }
+    }
+    int result = do_mount(&iosfs, source.UTF8String, mount_point, "", 0);
+    unlock(&mounts_lock);
+    return result;
+}

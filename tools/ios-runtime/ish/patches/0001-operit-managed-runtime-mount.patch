@@ -185,3 +190,61 @@ ssize_t linux_write_file(const char *path, const char *buf, size_t size) {
 int linux_remove_directory(const char *path) {
     return init_rmdir(path);
 }
+
+// Creates one Linux directory from the iOS host bridge.
+int linux_make_directory(const char *path) {
+    return init_mkdir(path, 0755);
+}
+
+struct operit_runtime_mount {
+    char *host_directory;
+    char *mount_point;
+    struct list_head entry;
+};
+
+static LIST_HEAD(operit_runtime_mounts);
+static DEFINE_MUTEX(operit_runtime_mounts_lock);
+
+// Mounts an App-owned directory through the Linux hostfs implementation.
+int linux_mount_app_directory(const char *directory, const char *mount_point) {
+    if (directory == NULL || mount_point == NULL || directory[0] != '/' || mount_point[0] != '/')
+        return -EINVAL;
+
+    int result = 0;
+    mutex_lock(&operit_runtime_mounts_lock);
+    struct operit_runtime_mount *existing;
+    list_for_each_entry(existing, &operit_runtime_mounts, entry) {
+        if (strcmp(existing->mount_point, mount_point) == 0) {
+            result = strcmp(existing->host_directory, directory) == 0 ? 0 : -EBUSY;
+            goto out_unlock;
+        }
+    }
+
+    struct operit_runtime_mount *mount = kzalloc(sizeof(*mount), GFP_KERNEL);
+    if (mount == NULL) {
+        result = -ENOMEM;
+        goto out_unlock;
+    }
+    mount->host_directory = kstrdup(directory, GFP_KERNEL);
+    mount->mount_point = kstrdup(mount_point, GFP_KERNEL);
+    if (mount->host_directory == NULL || mount->mount_point == NULL) {
+        kfree(mount->host_directory);
+        kfree(mount->mount_point);
+        kfree(mount);
+        result = -ENOMEM;
+        goto out_unlock;
+    }
+
+    result = do_mount(directory, mount_point, "hostfs", MS_SILENT, NULL);
+    if (result != 0) {
+        kfree(mount->host_directory);
+        kfree(mount->mount_point);
+        kfree(mount);
+        goto out_unlock;
+    }
+    list_add_tail(&mount->entry, &operit_runtime_mounts);
+
+out_unlock:
+    mutex_unlock(&operit_runtime_mounts_lock);
+    return result;
+}

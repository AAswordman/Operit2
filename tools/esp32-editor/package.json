{
  "name": "operit-esp32-editor",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --experimental-strip-types src/server.mts",
    "build": "node --experimental-strip-types src/build.mts",
    "build:firmware": "node --experimental-strip-types src/build.mts --firmware",
    "test": "node --test --experimental-strip-types tests/*.test.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "dev": "node --experimental-strip-types src/device.mts dev",
    "flash": "node --experimental-strip-types src/device.mts flash",
    "flash:fresh": "node --experimental-strip-types src/device.mts flash --reset-data",
    "monitor": "node --experimental-strip-types src/device.mts monitor",
    "ports": "node --experimental-strip-types src/device.mts ports",
    "device:setup": "node --experimental-strip-types src/device.mts setup",
    "agent": "node --experimental-strip-types src/agent.mts",
    "dev:fresh": "node --experimental-strip-types src/device.mts dev --reset-data",
    "device:screen": "node --experimental-strip-types src/device.mts screen",
    "device:health": "node --experimental-strip-types src/device.mts health",
    "device:tree": "node --experimental-strip-types src/device.mts tree",
    "device:tap": "node --experimental-strip-types src/device.mts tap",
    "device:swipe": "node --experimental-strip-types src/device.mts swipe",
    "test:hardware": "python -X utf8 device-smoke.py",
    "test:device-debug": "python -X utf8 -m unittest discover -s tests -p test_device_*.py",
    "test:xtensa": "python -X utf8 -m unittest discover -s tests -p test_xtensa_overlay.py",
    "device:draft": "node --experimental-strip-types src/device.mts draft",
    "device:session": "python -X utf8 device-session.py"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "typescript": "5.9.3"
  }
}

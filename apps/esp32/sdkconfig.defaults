CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_FREERTOS_HZ=1000
# Main also performs synchronous UI authorization and storage decoding.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# Runtime disables console logs once binary Link owns UART. Keep C errors,
# and return driver errors without linking their repeated ESP_RETURN_ON_* log text.
CONFIG_LOG_DEFAULT_LEVEL_ERROR=y
CONFIG_COMPILER_OPTIMIZATION_CHECKS_SILENT=y
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_STA_ENABLED=y
# Keep Wi-Fi RX buffers proportional to this low-memory Edge device.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
# Browser setup requests include User-Agent, client hints and other headers.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=4096
CONFIG_SPIFFS=y

# Native device requests verify HTTPS using the ESP-IDF certificate bundle.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# Keep microphone DMA interrupts running during Flash/NVS cache stalls.
CONFIG_I2S_ISR_IRAM_SAFE=y
